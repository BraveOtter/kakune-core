[Unit]
Description=Kakune Core local automation runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=root
ExecStart=/usr/local/bin/kakune service run --data-dir /var/lib/kakune
Restart=on-failure
RestartSec=5
KillMode=mixed
SendSIGKILL=no
TimeoutStartSec=30
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kakune

[Install]
WantedBy=multi-user.target
